# Copy this file to .env.local for local development, and set the same two
# variables in Vercel (Project → Settings → Environment Variables) for the live
# site. Both values are safe to expose in the browser — the anon key is public
# and row-level security is what protects the data.
#
# When these are set, the app talks to your real Supabase project. When they are
# absent, it runs the self-contained localStorage demo.
#
# The service_role key and any Anthropic API key are NOT set here — they belong
# only in Supabase Edge Function secrets, never in the frontend.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: set to false to force the demo even when the keys above are present.
# VITE_USE_SUPABASE=false
